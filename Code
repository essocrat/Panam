<!-- SEO & Social Meta -->
<meta name="description" content="Panama Live! — The insider expat guide to Panama City. Find live music, top restaurants, neighborhoods, healthcare, wellness, events, and more. Bilingual EN/ES."/>
<meta name="keywords" content="Panama City expat guide, live in Panama, Panama restaurants, Panama wellness, Panama yoga, Panama fitness, Panama events, Casco Viejo, expat Panama City, Panama nightlife, Panama healthcare, Panama neighborhoods"/>
<meta name="robots" content="index, follow"/>
