// ── Device Detection ──────────────────────────────
const DEV = (() => {
  const ua = navigator.userAgent;
  const touch = navigator.maxTouchPoints > 1;
  const w = window.innerWidth;
  const isIOS = /iPhone|iPad|iPod/i.test(ua);
  const isAndroid = /Android/i.test(ua);
  const isMobilePhone = (isIOS || isAndroid) && w < 640;
  const isTablet = touch && w >= 640 && w < 1024;
  const isDesktop = w >= 1024 && !isMobilePhone;
  const type = isMobilePhone ? 'mobile' : isTablet ? 'tablet' : 'desktop';
  const standalone = window.navigator.standalone || window.matchMedia('(display-mode: standalone)').matches;
  document.body.classList.add('is-' + type);
  if (isIOS) document.body.classList.add('is-ios');
  if (isAndroid) document.body.classList.add('is-android');
  if (standalone) document.body.classList.add('is-standalone');
  return { type, isMobile: isMobilePhone, isTablet, isDesktop, isIOS, isAndroid, touch, w };
})();

