    if (text.includes('pilates')||text.includes('reformer')) return addAiMsg(bank.pilates||fallback(text));
    if (text.includes('biohack')||text.includes('recover')||text.includes('iv ')||text.includes('cryo')||text.includes('longevity')) return addAiMsg(bank.biohacking||fallback(text));
    if (text.includes('retreat')||text.includes('retiro')||text.includes('buenaventura')||text.includes('boquete')) return addAiMsg(bank.retreat||fallback(text));
    if (text.includes('outdoor')||text.includes('beach')||text.includes('playa')||text.includes('cinta costera')) return addAiMsg(bank.outdoor||fallback(text));
