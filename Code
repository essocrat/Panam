  setTimeout(()=>{
    document.getElementById('typ')?.remove();
    const w=document.createElement('div');w.className='msg ai';
    const a=document.createElement('div');a.className='av ai';a.textContent='PL';
    const b=document.createElement('div');b.className='bubble';
    let html=`<p style="margin-bottom:${resp.cards||resp.sugs?'9px':'0'}">${resp.text}</p>`;
