function buildEventsView() {
  const scroll=document.getElementById('events-scroll');
  const filtersEl=document.getElementById('day-filters');
  scroll.innerHTML=''; filtersEl.innerHTML='';
  const days=[{code:'all',label:'All'},{code:'MON',label:'Mon'},{code:'TUE',label:'Tue'},{code:'WED',label:'Wed'},{code:'THU',label:'Thu'},{code:'FRI',label:'Fri'},{code:'SAT',label:'Sat'},{code:'SUN',label:'Sun'}];
  days.forEach(d=>{
    const b=document.createElement('button');
    b.className='day-filter'+(activeDay===d.code?' active':'');
    b.textContent=d.label;
    b.onclick=()=>{activeDay=d.code;buildEventsView();};
    filtersEl.appendChild(b);
  });
  if (activeDay==='all') {
    const t5=document.createElement('div');t5.className='top5-section';
    t5.innerHTML=`<div class="top5-title">⭐ Top 5 Events This Week</div>`+TOP5.map(e=>`<div class="top5-item"><div class="top5-rank">${e.rank}</div><div class="top5-content"><div class="top5-event">${e.event}</div><div class="top5-venue">${e.venue}</div><div class="top5-why">${e.why}</div><div class="top5-for">Best for: ${e.forTag}</div></div></div>`).join('');
    scroll.appendChild(t5);
  }
  const dayOrder=['MON','TUE','WED','THU','FRI','SAT','SUN'];
  const dayMeta={MON:{full:'Monday',date:'May 4',vibe:'A lighter start — jazz, cigars, and early-week social.'},TUE:{full:'Tuesday',date:'May 5',vibe:"The week's best jazz night. No debate."},WED:{full:'Wednesday',date:'May 6',vibe:'Latin jazz at a luxury hotel + community game night.'},THU:{full:'Thursday',date:'May 7',vibe:'Classic jazz + live bands. The week peaks early.'},FRI:{full:'Friday',date:'May 8',vibe:'The city opens up. Rooftops, live music, and nightlife.'},SAT:{full:'Saturday',date:'May 9',vibe:'Full day and night. Brunch, live bands, and dancing.'},SUN:{full:'Sunday',date:'May 10',vibe:'Wind down with soul food, jazz brunch, and rooftop.'}};
  dayOrder.forEach(dayCode=>{
    if (activeDay!=='all'&&activeDay!==dayCode) return;
    const eventsForDay=EVENTS.filter(e=>e.day===dayCode);
    const meta=dayMeta[dayCode];
    const color=DAY_COLORS[dayCode];
    const section=document.createElement('div');section.className='day-section';
    const hdr=document.createElement('div');hdr.className='day-header-bar';hdr.style.background=color;
    hdr.innerHTML=`<span class="day-abbr">${dayCode}</span><div><div class="day-full">${meta.full}</div><div class="day-vibe">${meta.vibe}</div></div><span class="day-date">${meta.date}</span>`;
    section.appendChild(hdr);
    eventsForDay.forEach(ev=>{
      const ts=TYPE_STYLES[ev.type]||TYPE_STYLES.social;
      const card=document.createElement('div');card.className='event-card';
      const tagHTML=ev.tags.map(t=>{
        let cls='event-tag';
        if (t.includes('⭐')||t.includes('MISS')||t.includes('TOP')||t.includes('WEEKLY')) cls+=' hot';
        else if (t.includes('NEAR')) cls+=' nearby';
        else if (t.includes('UPSCALE')||t.includes('DATE')) cls+=' upscale';
        else if (t.includes('FREE')) cls+=' free';
        return `<span class="${cls}">${t}</span>`;
      }).join('');
      card.innerHTML=`<div class="event-card-top"><div class="event-type-bar" style="background:${ts.bg}"></div><div class="event-card-body"><div class="event-tag-row"><span class="event-type-pill" style="background:${ts.bg};color:${ts.fg}">${ts.label}</span>${ev.star?'<span class="star-badge">⭐ Must-Go</span>':''}</div><div class="event-name">${ev.name}</div><div class="event-meta"><span class="event-venue">${ev.venue}</span><span class="event-time">${ev.time}</span></div><div class="event-detail">${ev.detail}</div><div class="event-tags">${tagHTML}</div></div></div>`;
      section.appendChild(card);
    });
    scroll.appendChild(section);
  });
  const fn=document.createElement('div');fn.className='footer-note';
  fn.textContent='⚠️ Recurring events confirmed via verified venue sources. Verify specific artist bookings via venue Instagram before attending.';
  scroll.appendChild(fn);
}

