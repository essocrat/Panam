  if (text.includes('salsa')||text.includes('danc')||text.includes('baile')) return addAiMsg(bank.salsa||fallback(text));
  if (text.includes('tonight')||text.includes('hoy')||text.includes('esta noche')) return addAiMsg(bank.tonight||fallback(text));
  if (text.includes('date')||text.includes('cita')||text.includes('románt')) return addAiMsg(bank.date||fallback(text));
  if (text.includes('local')||text.includes('cheap')||text.includes('budget')||text.includes('barato')) return addAiMsg(bank.local||bank.budget||fallback(text));
  if (text.includes('vegetar')||text.includes('vegan')) return addAiMsg(bank.vegetarian||fallback(text));
  if (text.includes('famil')||text.includes('kid')||text.includes('niño')) return addAiMsg(bank.family||fallback(text));
  if (text.includes('walk')||text.includes('camin')) return addAiMsg(bank.walkable||fallback(text));
  if (text.includes('rent')||text.includes('cost')||text.includes('precio')||text.includes('alquil')) return addAiMsg(bank.cost||fallback(text));
  if (text.includes('insur')||text.includes('seguro médic')) return addAiMsg(bank.insurance||fallback(text));
  if (text.includes('dental')||text.includes('diente')) return addAiMsg(bank.dental||fallback(text));
  if (text.includes('emerg')) return addAiMsg(bank.emergency||fallback(text));
  if (text.includes('bocas')) return addAiMsg(bank.bocas||fallback(text));
  if (text.includes('boquete')||text.includes('mountain')) return addAiMsg(bank.boquete||fallback(text));
  if (text.includes('document')||text.includes('pasaport')) return addAiMsg(bank.documents||fallback(text));
  if (text.includes('transfer')||text.includes('wise')||text.includes('enviar')) return addAiMsg(bank.transfers||fallback(text));
  if (text.includes('offshore')) return addAiMsg(bank.offshore||fallback(text));
