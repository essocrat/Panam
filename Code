function addAiMsg(resp) {
  const t=document.createElement('div');t.className='msg ai';t.id='typ';
  t.innerHTML=`<div class="av ai">PL</div><div class="typing"><span class="dot"></span><span class="dot"></span><span class="dot"></span></div>`;
