<meta property="og:title" content="Panama Live! — Your Expat City Guide"/>
<meta property="og:description" content="The insider guide to expat life in Panama City. Live music, restaurants, wellness, events and more. Bilingual EN/ES."/>
<meta property="og:type" content="website"/>
<meta property="og:locale" content="en_US"/>
<meta property="og:locale:alternate" content="es_PA"/>
<meta name="twitter:card" content="summary"/>
<meta name="twitter:title" content="Panama Live! — Your Expat City Guide"/>
<meta name="twitter:description" content="Insider guide to expat life in Panama City — music, food, wellness, events and more."/>

<link rel="preconnect" href="https://fonts.googleapis.com"/>
<link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@400;600;700&family=DM+Sans:wght@300;400;500&display=swap" rel="stylesheet"/>
<style>
*{box-sizing:border-box;margin:0;padding:0;-webkit-tap-highlight-color:transparent;}
:root{
  --ink:#0d1117;--ink2:#2a2f3a;--ink3:#5a5a68;
  --paper:#faf8f5;--paper2:#f3eeea;--paper3:#ece7e0;--line:#e2ddd6;
  --red:#c0392b;--gold:#c9933a;--gold-bg:#fdf3e2;
  --green:#2d7a4f;--green-bg:#e8f5ee;
  --r:16px;--header-h:56px;--sidebar-w:200px;--bottom-nav-h:60px;
  --safe-bottom:env(safe-area-inset-bottom,0px);
}
html,body{height:100%;overflow:hidden;}
body{font-family:'DM Sans',sans-serif;background:var(--paper3);color:var(--ink);overscroll-behavior:none;}
.app-shell{display:flex;flex-direction:column;height:100%;height:100dvh;max-width:1200px;margin:0 auto;background:#fff;}
.top-header{display:flex;align-items:center;gap:10px;padding:0 16px;height:var(--header-h);background:#fff;border-bottom:1px solid var(--line);flex-shrink:0;position:relative;z-index:10;}
.logo-mark{width:34px;height:34px;border-radius:9px;background:var(--ink);display:flex;align-items:center;justify-content:center;flex-shrink:0;}
.logo-mark svg{width:19px;height:19px;}
.header-title{font-family:'Cormorant Garamond',serif;font-size:20px;font-weight:700;color:var(--ink);line-height:1;white-space:nowrap;}
.header-title em{color:var(--red);font-style:normal;}
.header-sub{font-size:10px;color:#aaa09a;letter-spacing:0.07em;text-transform:uppercase;display:flex;align-items:center;gap:4px;}
.live-dot{width:5px;height:5px;border-radius:50%;background:var(--red);display:inline-block;animation:pulse 1.8s infinite;}
@keyframes pulse{0%,100%{opacity:1;}50%{opacity:.25;}}
.header-brand{display:flex;flex-direction:column;gap:2px;min-width:0;flex:1;}
.lang-wrap{display:flex;align-items:center;gap:6px;margin-left:auto;flex-shrink:0;}
.lang-lbl{font-size:10.5px;color:#b0a89e;}
.lang-toggle{display:flex;background:var(--paper2);border:1px solid var(--line);border-radius:20px;padding:3px;gap:2px;}
.lang-btn{font-size:11px;font-weight:500;padding:4px 12px;border-radius:14px;border:none;cursor:pointer;font-family:'DM Sans',sans-serif;color:#7a7068;background:transparent;transition:all .15s;}
.lang-btn.active{background:var(--ink);color:#f5c76e;}
.body-layout{display:flex;flex:1;overflow:hidden;}
.sidebar{width:var(--sidebar-w);flex-shrink:0;background:var(--paper);border-right:1px solid var(--line);display:flex;flex-direction:column;overflow-y:auto;scrollbar-width:none;transition:transform .28s cubic-bezier(.4,0,.2,1);}
.sidebar::-webkit-scrollbar{display:none;}
.nav-section-lbl{font-size:9px;font-weight:500;color:#b0a89e;letter-spacing:.09em;text-transform:uppercase;padding:12px 16px 4px;}
.nav-btn{display:flex;align-items:center;gap:9px;padding:9px 16px;border:none;background:transparent;cursor:pointer;font-family:'DM Sans',sans-serif;color:#7a7068;transition:all .14s;width:100%;text-align:left;border-left:3px solid transparent;}
.nav-btn svg{width:15px;height:15px;flex-shrink:0;}
.nav-btn span{font-size:12.5px;font-weight:500;white-space:nowrap;}
.nav-btn:hover:not(.active){background:var(--paper2);color:var(--ink2);}
.nav-btn.active{background:#fff;color:var(--ink);border-left-color:var(--red);}
.nav-btn.active svg{color:var(--red);}
.nav-btn.wellness-btn.active{border-left-color:var(--green);}
.nav-btn.wellness-btn.active svg{color:var(--green);}
.nav-btn.events-btn{color:#8b5a1a;}
.nav-btn.events-btn.active{background:#fff;color:var(--ink);border-left-color:var(--gold);}
.week-badge{font-size:8px;font-weight:700;background:var(--gold);color:#fff;border-radius:10px;padding:1px 5px;margin-left:auto;flex-shrink:0;}
.new-badge{font-size:8px;font-weight:700;background:var(--green);color:#fff;border-radius:10px;padding:1px 5px;margin-left:auto;flex-shrink:0;}
.sidebar-divider{height:1px;background:var(--line);margin:4px 12px;}
.sidebar-footer{margin-top:auto;padding:10px 16px;border-top:1px solid var(--line);}
.sidebar-footer p{font-size:10px;color:#c0b8b0;line-height:1.5;}
.drawer-overlay{display:none;position:fixed;inset:0;background:rgba(0,0,0,.4);z-index:50;opacity:0;transition:opacity .25s;pointer-events:none;}
.drawer-overlay.open{opacity:1;pointer-events:all;}
.main-panel{flex:1;display:flex;flex-direction:column;overflow:hidden;min-width:0;}
.chat-view{flex:1;display:flex;flex-direction:column;overflow:hidden;}
.chat-scroll{flex:1;overflow-y:auto;padding:16px;display:flex;flex-direction:column;gap:10px;background:var(--paper);scrollbar-width:thin;}
.chat-scroll::-webkit-scrollbar{width:3px;}
.chat-scroll::-webkit-scrollbar-thumb{background:var(--line);border-radius:2px;}
.msg{display:flex;gap:8px;max-width:96%;animation:msgup .2s ease;}
@keyframes msgup{from{opacity:0;transform:translateY(4px);}to{opacity:1;transform:translateY(0);}}
.msg.user{align-self:flex-end;flex-direction:row-reverse;}
.av{width:26px;height:26px;border-radius:7px;flex-shrink:0;display:flex;align-items:center;justify-content:center;font-size:9px;font-weight:600;}
.av.ai{background:var(--ink);color:#f5c76e;}
.av.user{background:#dbeafe;color:#1e3a8a;}
.bubble{padding:10px 13px;border-radius:13px;font-size:13.5px;line-height:1.65;color:var(--ink);max-width:100%;}
.msg.ai .bubble{background:#fff;border:1px solid var(--line);border-top-left-radius:4px;}
.msg.user .bubble{background:var(--ink);color:#f0ead8;border-top-right-radius:4px;}
.card-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(130px,1fr));gap:7px;margin-top:8px;}
.card{background:#fff;border:1px solid var(--line);border-radius:10px;padding:9px 10px;cursor:pointer;transition:border-color .14s,box-shadow .14s;}
.card:hover{border-color:#b8b0a6;box-shadow:0 2px 8px rgba(0,0,0,.06);}
.card-tag{font-size:9px;font-weight:500;text-transform:uppercase;letter-spacing:.06em;color:#aaa09a;margin-bottom:3px;}
.card-name{font-family:'Cormorant Garamond',serif;font-size:14px;font-weight:500;color:var(--ink);line-height:1.3;}
.card-meta{font-size:10.5px;color:#7a7068;margin-top:2px;}
.card-badge{display:inline-block;font-size:9px;padding:2px 6px;border-radius:7px;margin-top:4px;background:var(--paper2);color:#6b6258;border:1px solid var(--line);}
.card-badge.green{background:var(--green-bg);color:var(--green);border-color:#b8d8c8;}
.sec-lbl{font-size:9.5px;font-weight:500;color:#aaa09a;text-transform:uppercase;letter-spacing:.07em;margin:4px 0 2px;}
.sugs{display:flex;flex-wrap:wrap;gap:5px;margin-top:8px;}
.sug{font-size:11.5px;padding:5px 11px;border-radius:20px;border:1px solid #d8d2ca;background:#fff;color:#7a7068;cursor:pointer;font-family:'DM Sans',sans-serif;transition:all .14s;}
.sug:hover{background:var(--paper2);color:var(--ink2);border-color:#b0a89e;}
.typing{display:flex;align-items:center;gap:4px;padding:9px 13px;background:#fff;border:1px solid var(--line);border-radius:13px;border-top-left-radius:4px;width:fit-content;}
.dot{width:5px;height:5px;border-radius:50%;background:#b8b0a6;animation:bounce 1.2s infinite;}
.dot:nth-child(2){animation-delay:.2s;}.dot:nth-child(3){animation-delay:.4s;}
@keyframes bounce{0%,60%,100%{transform:translateY(0);}30%{transform:translateY(-4px);}}

/* Wellness result table */
.wellness-result{margin-top:10px;width:100%;overflow-x:auto;}
.wellness-table{width:100%;border-collapse:collapse;font-size:12px;}
.wellness-table th{background:var(--ink);color:#f5c76e;font-size:10px;font-weight:600;letter-spacing:.05em;text-transform:uppercase;padding:7px 10px;text-align:left;white-space:nowrap;}
.wellness-table td{padding:8px 10px;border-bottom:1px solid var(--line);vertical-align:top;line-height:1.5;}
.wellness-table tr:hover td{background:var(--paper2);}
.wellness-table tr:last-child td{border-bottom:none;}
.w-cat-pill{display:inline-block;font-size:9px;font-weight:600;padding:2px 7px;border-radius:8px;white-space:nowrap;}
.w-vibe{display:inline-block;font-size:9px;padding:1px 6px;border-radius:6px;background:var(--paper2);color:#7a7068;border:1px solid var(--line);white-space:nowrap;}
.w-cost-free{color:var(--green);font-weight:600;}
.w-link{color:var(--red);text-decoration:none;font-size:10.5px;}
.w-link:hover{text-decoration:underline;}
.wellness-section-hdr{background:var(--green-bg);border-left:3px solid var(--green);padding:6px 10px;margin:10px 0 4px;border-radius:0 6px 6px 0;font-size:11px;font-weight:600;color:var(--green);}
.wellness-disclaimer{font-size:10.5px;color:#aaa09a;margin-top:8px;padding:8px 10px;background:var(--paper2);border-radius:8px;line-height:1.5;}

/* Loading pulse for wellness search */
.wellness-loading{display:flex;flex-direction:column;gap:6px;margin-top:10px;}
.wellness-loading-bar{height:10px;border-radius:4px;background:linear-gradient(90deg,var(--line) 25%,var(--paper2) 50%,var(--line) 75%);background-size:200% 100%;animation:shimmer 1.2s infinite;}
@keyframes shimmer{0%{background-position:200% 0;}100%{background-position:-200% 0;}}
.wellness-loading-bar:nth-child(2){width:85%;}
.wellness-loading-bar:nth-child(3){width:70%;}

.input-bar{padding:10px 12px;padding-bottom:calc(10px + var(--safe-bottom));border-top:1px solid var(--line);display:flex;gap:8px;align-items:flex-end;background:#fff;flex-shrink:0;}
.input-bar textarea{flex:1;font-family:'DM Sans',sans-serif;font-size:14px;padding:9px 13px;border-radius:10px;border:1px solid #d0cbc4;background:var(--paper);color:var(--ink);resize:none;line-height:1.5;max-height:90px;min-height:38px;outline:none;transition:border-color .14s;}
.input-bar textarea:focus{border-color:#999;background:#fff;}
.input-bar textarea::placeholder{color:#b8b0a8;}
.send-btn{width:38px;height:38px;border-radius:10px;background:var(--ink);border:none;cursor:pointer;display:flex;align-items:center;justify-content:center;flex-shrink:0;transition:opacity .14s;}
.send-btn:hover{opacity:.8;}
.send-btn:active{opacity:.6;}
.events-view{flex:1;display:none;flex-direction:column;overflow:hidden;background:var(--paper);}
.events-view.active{display:flex;}
.events-header{padding:12px 16px 10px;background:var(--ink);flex-shrink:0;display:flex;align-items:flex-start;justify-content:space-between;flex-wrap:wrap;gap:8px;}
.events-header h2{font-family:'Cormorant Garamond',serif;font-size:18px;font-weight:700;color:#f5c76e;line-height:1;}
.events-header p{font-size:10.5px;color:#7a7068;margin-top:3px;}
.day-filters-wrap{display:flex;gap:5px;flex-wrap:wrap;}
.day-filter{font-size:11px;font-weight:500;padding:4px 10px;border-radius:14px;border:1px solid #2a2f3a;background:transparent;color:#7a7068;cursor:pointer;font-family:'DM Sans',sans-serif;transition:all .14s;}
.day-filter.active{background:var(--gold);color:#fff;border-color:var(--gold);}
.day-filter:hover:not(.active){background:#1a1f2e;color:#f5c76e;border-color:#3a3f4a;}
.events-scroll{flex:1;overflow-y:auto;padding:12px;scrollbar-width:thin;}
.events-scroll::-webkit-scrollbar{width:3px;}
.events-scroll::-webkit-scrollbar-thumb{background:var(--line);border-radius:2px;}
.day-section{margin-bottom:18px;animation:msgup .2s ease;}
.day-header-bar{display:flex;align-items:center;gap:10px;padding:8px 12px;border-radius:10px;margin-bottom:8px;}
.day-header-bar .day-abbr{font-size:10px;font-weight:700;color:#fff;opacity:.9;letter-spacing:.05em;}
.day-header-bar .day-full{font-family:'Cormorant Garamond',serif;font-size:15px;font-weight:700;color:#fff;}
.day-header-bar .day-date{font-size:11px;color:rgba(255,255,255,.6);margin-left:auto;}
.day-header-bar .day-vibe{font-size:10.5px;color:rgba(255,255,255,.75);margin-top:1px;}
.event-card{background:#fff;border:1px solid var(--line);border-radius:10px;overflow:hidden;margin-bottom:7px;transition:box-shadow .14s;}
.event-card:hover{box-shadow:0 3px 12px rgba(0,0,0,.08);}
.event-card-top{display:flex;align-items:stretch;}
.event-type-bar{width:5px;flex-shrink:0;}
.event-card-body{flex:1;padding:9px 12px;}
.event-tag-row{display:flex;align-items:center;gap:6px;margin-bottom:4px;flex-wrap:wrap;}
.event-type-pill{font-size:9.5px;font-weight:600;padding:2px 8px;border-radius:10px;letter-spacing:.04em;}
.star-badge{font-size:9.5px;font-weight:700;color:var(--gold);background:var(--gold-bg);border:1px solid #e8d5a0;padding:2px 7px;border-radius:10px;}
.event-name{font-family:'Cormorant Garamond',serif;font-size:14px;font-weight:700;color:var(--ink);line-height:1.3;margin-bottom:4px;}
.event-meta{display:flex;align-items:center;gap:10px;margin-bottom:5px;flex-wrap:wrap;}
.event-venue{font-size:11.5px;font-weight:500;color:var(--ink2);}
.event-venue::before{content:"📍 ";}
.event-time{font-size:11.5px;font-weight:600;color:var(--red);}
.event-time::before{content:"🕐 ";}
.event-detail{font-size:12px;color:#5a5450;line-height:1.55;}
.event-tags{display:flex;gap:5px;margin-top:5px;flex-wrap:wrap;}
.event-tag{font-size:9px;font-weight:500;padding:2px 7px;border-radius:8px;background:var(--paper2);color:#7a7068;border:1px solid var(--line);}
.event-tag.hot{background:var(--gold-bg);color:#8b5a1a;border-color:#e8d5a0;}
.event-tag.nearby{background:#e8f4e8;color:#2d6a3f;border-color:#b8d8b8;}
.event-tag.upscale{background:#e8e0f4;color:#4a3a6b;border-color:#c8b8e8;}
.event-tag.free{background:#e0f4e8;color:#1a5c3a;border-color:#a8d8b8;}
.top5-section{background:var(--ink);border-radius:12px;padding:14px 16px;margin-bottom:14px;}
.top5-title{font-family:'Cormorant Garamond',serif;font-size:16px;font-weight:700;color:#f5c76e;margin-bottom:10px;display:flex;align-items:center;gap:8px;}
.top5-item{display:flex;align-items:flex-start;gap:10px;padding:8px 0;border-bottom:1px solid #1a1f2e;}
.top5-item:last-child{border-bottom:none;padding-bottom:0;}
.top5-rank{width:26px;height:26px;border-radius:8px;background:var(--gold);display:flex;align-items:center;justify-content:center;font-size:13px;font-weight:700;color:#fff;flex-shrink:0;}
.top5-content{flex:1;}
.top5-event{font-size:13px;font-weight:600;color:#fff;line-height:1.3;}
.top5-venue{font-size:11px;color:var(--gold);margin-top:1px;}
.top5-why{font-size:11.5px;color:#8a8078;margin-top:3px;line-height:1.4;}
.top5-for{font-size:10.5px;font-weight:600;color:var(--red);margin-top:4px;}
.footer-note{font-size:10px;color:#b0a89e;text-align:center;padding:8px 0 4px;line-height:1.5;}
.bottom-nav{display:none;border-top:1px solid var(--line);background:#fff;padding-bottom:var(--safe-bottom);flex-shrink:0;z-index:10;}
.bottom-nav-inner{display:flex;height:var(--bottom-nav-h);}
.bnav-btn{flex:1;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:3px;border:none;background:transparent;cursor:pointer;color:#9a9088;font-family:'DM Sans',sans-serif;font-size:10px;font-weight:500;transition:color .14s;padding:0;-webkit-tap-highlight-color:transparent;}
.bnav-btn svg{width:20px;height:20px;}
.bnav-btn.active{color:var(--red);}
.bnav-btn.events.active{color:var(--gold);}
.bnav-btn.wellness.active{color:var(--green);}
.device-badge{display:none;position:fixed;top:4px;right:4px;background:rgba(0,0,0,.7);color:#fff;font-size:10px;padding:2px 6px;border-radius:4px;z-index:999;}

@media (max-width:639px){
  .lang-lbl{display:none;}
  .sidebar{position:fixed;top:0;left:0;bottom:0;z-index:60;width:min(85vw,300px);transform:translateX(-100%);box-shadow:none;}
  .sidebar.drawer-open{transform:translateX(0);box-shadow:4px 0 24px rgba(0,0,0,.18);}
  .drawer-overlay{display:block;}
  .bottom-nav{display:block;}
  .top-header{padding:0 14px;height:52px;}
  .header-title{font-size:18px;}
  .chat-scroll{padding:12px;}
  .events-header{flex-direction:column;}
  .day-filters-wrap{overflow-x:auto;flex-wrap:nowrap;scrollbar-width:none;-webkit-overflow-scrolling:touch;padding-bottom:2px;}
  .day-filters-wrap::-webkit-scrollbar{display:none;}
  .card-grid{grid-template-columns:repeat(auto-fill,minmax(120px,1fr));}
  .events-scroll{padding-bottom:calc(12px + var(--safe-bottom));}
  .wellness-table{font-size:11px;}
  .wellness-table th,.wellness-table td{padding:6px 8px;}
}
@media (min-width:640px) and (max-width:1023px){
  :root{--sidebar-w:60px;}
  .nav-btn span{display:none;}
  .nav-section-lbl{display:none;}
  .sidebar-footer{display:none;}
  .sidebar-divider{margin:4px 8px;}
  .nav-btn{justify-content:center;padding:10px;border-left:none;border-bottom:3px solid transparent;}
  .nav-btn.active{border-left:none;border-bottom-color:var(--red);background:var(--paper2);}
  .nav-btn.wellness-btn.active{border-bottom-color:var(--green);}
  .nav-btn.events-btn.active{border-bottom-color:var(--gold);}
  .week-badge,.new-badge{display:none;}
  .lang-lbl{display:none;}
  .header-sub{display:none;}
}
@media (min-width:640px) and (max-width:1023px){
  .nav-btn{position:relative;}
  .nav-btn:hover::after{content:attr(data-label);position:absolute;left:calc(100% + 8px);top:50%;transform:translateY(-50%);background:var(--ink);color:#fff;font-size:11px;font-weight:500;white-space:nowrap;padding:5px 10px;border-radius:7px;z-index:100;pointer-events:none;}
  .nav-btn:hover::before{content:'';position:absolute;left:100%;top:50%;transform:translateY(-50%);border:5px solid transparent;border-right-color:var(--ink);z-index:100;}
}
@media (min-width:1024px){
  .sidebar{display:flex !important;}
  .bottom-nav{display:none !important;}
  .drawer-overlay{display:none !important;}
}
@media (hover:none) and (pointer:coarse){
  .sug{padding:7px 13px;font-size:12px;}
  .card{padding:11px 12px;}
  .day-filter{padding:6px 12px;}
  .nav-btn{padding:12px 16px;}
}
@media (max-width:820px) and (orientation:landscape) and (max-height:500px){
  :root{--header-h:44px;--bottom-nav-h:50px;}
  .header-title{font-size:16px;}
  .chat-scroll{padding:8px;}
}
@media (min-width:1280px){
  :root{--sidebar-w:220px;}
  .app-shell{max-width:1200px;box-shadow:0 8px 48px rgba(0,0,0,.1);border-left:1px solid var(--line);border-right:1px solid var(--line);}
}
</style>
</head>
<body>
<div class="device-badge" id="dev-badge"></div>
<div class="drawer-overlay" id="overlay" onclick="closeSidebar()"></div>
<div class="app-shell" id="app">
  <header class="top-header">
    <div class="logo-mark">
      <svg viewBox="0 0 22 22" fill="none">
        <path d="M4 16 Q11 4 18 16" stroke="#c0392b" stroke-width="1.8" stroke-linecap="round"/>
        <circle cx="11" cy="16" r="2" fill="#f5c76e"/>
        <path d="M8 13 Q11 9 14 13" stroke="#f5c76e" stroke-width="1.4" stroke-linecap="round"/>
      </svg>
    </div>
    <div class="header-brand">
      <div class="header-title">Panama <em>Live!</em></div>
      <div class="header-sub"><span class="live-dot"></span><span id="tagline">Bienvenido! Your Guide To Panama</span></div>
    </div>
    <div class="lang-wrap">
      <span class="lang-lbl" id="lang-lbl">Language</span>
